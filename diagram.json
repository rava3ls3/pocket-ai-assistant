{
  "version": 1,
  "author": "Pocket AI Assistant (simulation build)",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-xiao-esp32-s3",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "serialInterface": "USB_SERIAL_JTAG" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -60,
      "left": 160,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnAsk",
      "top": 60,
      "left": 160,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnUp",
      "top": 60,
      "left": 220,
      "attrs": { "color": "blue" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnDown",
      "top": 120,
      "left": 220,
      "attrs": { "color": "blue" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 120,
      "left": 160,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 120,
      "left": 120,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:D4",  "oled1:SDA", "green",  [] ],
    [ "esp:D5",  "oled1:SCL", "yellow", [] ],
    [ "esp:3V3", "oled1:VCC", "red",    [] ],
    [ "esp:GND", "oled1:GND", "black",  [] ],

    [ "esp:D0",      "btnAsk:1.l", "orange", [] ],
    [ "btnAsk:2.l",  "esp:GND",    "black",  [] ],

    [ "esp:D1",      "btnUp:1.l",  "orange", [] ],
    [ "btnUp:2.l",   "esp:GND",    "black",  [] ],

    [ "esp:D3",      "btnDown:1.l","orange", [] ],
    [ "btnDown:2.l", "esp:GND",    "black",  [] ],

    [ "esp:D8",  "r1:1",      "blue",  [] ],
    [ "r1:2",    "led1:A",    "blue",  [] ],
    [ "led1:C",  "esp:GND",   "black", [] ]
  ],
  "dependencies": {}
}
