// Salin file ini menjadi "secrets.h" (tanpa .example) lalu isi nilainya.
// src/secrets.h di-gitignore, jadi API key tidak akan ikut ter-commit.

#pragma once

// Di simulasi Wokwi, gunakan SSID khusus ini supaya ESP32 mendapat akses
// internet asli lewat gateway Wokwi. Jangan diganti saat masih di simulator.
#define WIFI_SSID "Wokwi-GUEST"
#define WIFI_PASSWORD ""

// Ambil API key gratis di https://build.nvidia.com (daftar akun -> generate
// API key -> biasanya langsung dapat free credits tanpa perlu isi saldo).
#define NVIDIA_API_KEY "nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// ID model persis seperti tercantum di katalog build.nvidia.com.
// Beberapa varian Nemotron 3 / 3.5 yang tersedia per Okt 2026 (cek ulang di
// build.nvidia.com, katalog + status EOL sering berubah):
//   nvidia/nemotron-3.5-lightning-30b-a3b   (default di bawah, tercepat)
//   nvidia/nemotron-3-super-120b-a12b       (reasoning, lebih akurat & lambat)
//   nvidia/nemotron-3-ultra-550b-a55b       (paling besar/mahal)
#define NVIDIA_MODEL "nvidia/nemotron-3.5-lightning-30b-a3b"

// --- Opsional: integrasi Home Assistant lewat Firebase Realtime Database ---
// --- (biar bisa tanya/baca jawaban panjang lewat app HA Companion di HP, ---
// --- bukan cuma OLED+Serial). Kosongkan FIREBASE_DB_URL ("") untuk       ---
// --- mematikan fitur ini sepenuhnya.                                    ---
//
// Kenapa lewat Firebase, bukan langsung ke HA? Supaya HA TIDAK perlu bisa
// diakses dari internet (tidak perlu tunnel/Nabu Casa). ESP32 dan HA
// sama-sama cuma connect KELUAR ke Firebase (URL-nya permanen, tidak
// pernah berubah) -- lihat README bagian "Tanya/baca jawaban panjang lewat
// HP" untuk setup project Firebase + automation HA lengkapnya.
//
// FIREBASE_DB_URL: URL Realtime Database kamu, format:
//   https://<project-id>-default-rtdb.<region>.firebasedatabase.app
#define FIREBASE_DB_URL "https://xxxx-default-rtdb.asia-southeast1.firebasedatabase.app"

// FIREBASE_SECRET_PATH: path acak panjang yang DIBUAT PUBLIK (read+write)
// lewat Security Rules -- berperan sebagai "kunci", path lain tetap
// terkunci. Generate sendiri string acak panjang, jangan dipakai yang
// gampang ditebak seperti "pocket_ai" saja. Contoh generate di Linux/Mac:
//   echo "pocket_ai_$(openssl rand -hex 16)"
#define FIREBASE_SECRET_PATH "pocket_ai_GANTI_DENGAN_STRING_ACAK_PANJANG"
