// Salin file ini menjadi "secrets.h" (tanpa .example) lalu isi nilainya.
// src/secrets.h di-gitignore, jadi API key tidak akan ikut ter-commit.

#pragma once

// Di simulasi Wokwi, gunakan SSID khusus ini supaya ESP32 mendapat akses
// internet asli lewat gateway Wokwi. Jangan diganti saat masih di simulator.
#define WIFI_SSID "Wokwi-GUEST"
#define WIFI_PASSWORD ""

// Ambil API key gratis di https://build.nvidia.com (daftar akun -> generate
// API key -> biasanya langsung dapat free credits tanpa perlu isi saldo).
#define NVIDIA_API_KEY "nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// ID model persis seperti tercantum di katalog build.nvidia.com.
// Beberapa varian Nemotron 3 / 3.5 yang tersedia per Okt 2026 (cek ulang di
// build.nvidia.com, katalog + status EOL sering berubah):
//   nvidia/nemotron-3.5-lightning-30b-a3b   (default di bawah, tercepat)
//   nvidia/nemotron-3-super-120b-a12b       (reasoning, lebih akurat & lambat)
//   nvidia/nemotron-3-ultra-550b-a55b       (paling besar/mahal)
#define NVIDIA_MODEL "nvidia/nemotron-3.5-lightning-30b-a3b"

// --- Opsional: integrasi Home Assistant (biar bisa tanya/baca jawaban ---
// --- panjang lewat app HA Companion di HP, bukan cuma OLED+Serial)     ---
// Kosongkan HA_URL ("") untuk mematikan fitur ini sepenuhnya.
//
// HA_URL: alamat HA yang bisa diakses dari internet (karena ESP32 cuma bisa
// akses keluar/outbound, tidak bisa dihubungi dari jaringan lokal rumah).
// Contoh: Nabu Casa ("https://xxxx.ui.nabu.casa"), reverse proxy sendiri,
// atau (untuk testing sementara) Cloudflare Tunnel:
//   ~/bin/cloudflared tunnel --url http://localhost:8123
// URL dari Cloudflare Tunnel gratis ini SEMENTARA -- mati kalau prosesnya
// ditutup, dan berubah setiap kali dijalankan ulang.
#define HA_URL "https://xxxx.ui.nabu.casa"

// Long-Lived Access Token: di HA klik foto profil (kiri bawah) -> Security
// -> Long-Lived Access Tokens -> Create Token.
#define HA_TOKEN "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// Juga buat 1 helper teks di HA (sekali saja, lewat UI): Settings ->
// Devices & Services -> tab Helpers -> Create Helper -> Text ->
// Name: "pocket ai question" (jadi entity_id: input_text.pocket_ai_question)
// -> centang Advanced -> naikkan Maximum length kalau mau tanya sangat
// panjang (default 255 karakter sudah lumayan panjang).
