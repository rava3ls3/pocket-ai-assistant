// Salin file ini menjadi "secrets.h" (tanpa .example) lalu isi nilainya.
// src/secrets.h di-gitignore, jadi API key tidak akan ikut ter-commit.

#pragma once

// Di simulasi Wokwi, gunakan SSID khusus ini supaya ESP32 mendapat akses
// internet asli lewat gateway Wokwi. Jangan diganti saat masih di simulator.
#define WIFI_SSID "Wokwi-GUEST"
#define WIFI_PASSWORD ""

// Ambil API key gratis di https://build.nvidia.com (daftar akun -> generate
// API key -> biasanya langsung dapat free credits tanpa perlu isi saldo).
#define NVIDIA_API_KEY "nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// ID model persis seperti tercantum di katalog build.nvidia.com.
// Beberapa varian Nemotron 3 / 3.5 yang tersedia per Okt 2026 (cek ulang di
// build.nvidia.com, katalog + status EOL sering berubah):
//   nvidia/nemotron-3.5-lightning-30b-a3b   (default di bawah, tercepat)
//   nvidia/nemotron-3-super-120b-a12b       (reasoning, lebih akurat & lambat)
//   nvidia/nemotron-3-ultra-550b-a55b       (paling besar/mahal)
#define NVIDIA_MODEL "nvidia/nemotron-3.5-lightning-30b-a3b"
